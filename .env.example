# Environment-variable reference. app.py does not load this file automatically.
PUBLIC_PORT=8000
LIVE_PROVIDER=lolesports
LOLESPORTS_LEAGUES=lpl,lck,lec,vcs
LOLESPORTS_POLL_SECONDS=30
LOLESPORTS_DISCOVER_SECONDS=120
LOLESPORTS_WINDOW_DELAY_SECONDS=40
LOLESPORTS_HISTORY_SYNC_SECONDS=21600
LOLESPORTS_HISTORY_DAYS=14
LOLESPORTS_HISTORY_WORKERS=2
LOLESPORTS_HISTORY_MAX_NEW_GAMES=20
ALLOW_MANUAL_RESULT=false

# Optional: pin one verified series. Pinning requires exactly one league above.
# LOLESPORTS_MATCH_ID=116957100120526836
# LOLESPORTS_GAME_IDS=116957100120526837,116957100120526838,116957100120526839,116957100120526840,116957100120526841

# Local non-container defaults. app.py itself does not load .env automatically.
HOST=127.0.0.1
PORT=8000
DB_PATH=data/matches.sqlite3
MODEL_PATH=models/live.json

# Disabled legacy fallback; only used when LIVE_PROVIDER=cito is explicit.
# CITO_API_KEY=your_server_side_key
# CITO_POLL_SECONDS=30
# CITO_DISCOVER_SECONDS=600
# CITO_GAME_ID=your_game_id
# CITO_MATCH_ID=your_match_id
